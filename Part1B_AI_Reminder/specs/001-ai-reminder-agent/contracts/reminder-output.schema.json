{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "title",
    "date",
    "time",
    "timezone",
    "needs_clarification",
    "clarification_question",
    "confidence"
  ],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["CREATE", "RESCHEDULE", "SNOOZE", "CLARIFY", "INVALID"]
    },
    "title": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "date": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "time": {
      "type": ["string", "null"],
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
    },
    "timezone": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "needs_clarification": {
      "type": "boolean"
    },
    "clarification_question": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
